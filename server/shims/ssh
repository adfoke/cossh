#!/bin/sh
# sshx PATH shim：透明代理真 ssh。
# 仅当命令行里出现 tmux 时，后台解析出 (host, session) 上报给控制面（fire-and-forget，
# 绝不阻塞 ssh 本身），让画布能自动拉起该远端 tmux 会话的观察窗。
# 正常 ssh 用法零开销；SSHX_NO_OBSERVE=1 整体静音（观察窗自己就是这么防回声的）。
REAL_SSH=/usr/bin/ssh

case "$*" in
  *tmux*) ;;
  *) exec "$REAL_SSH" "$@" ;;
esac
[ -n "$SSHX_NO_OBSERVE" ] && exec "$REAL_SSH" "$@"

(
  # 解析在后台子壳进行；python3 缺失/解析失败都静默放弃，绝不影响真 ssh
  if command -v python3 >/dev/null 2>&1; then
    payload=$(python3 - "$@" <<'PY'
import json, re, sys
argv = sys.argv[1:]
opts_with_val = "bcDEeFIiLlOopw"  # 带值的 ssh 选项字母（best-effort，认不出只影响上报不影响 exec）
host = None
i = 0
while i < len(argv):
    a = argv[i]
    if a == "--":
        if i + 1 < len(argv): host = argv[i + 1]
        break
    if a.startswith("-"):
        flag = a[1:2]
        if flag in opts_with_val and not re.search(r"=", a):
            i += 2
            continue
        i += 1
        continue
    host = a
    break
    # (unreachable) i += 1
    i += 1
if not host:
    sys.exit(1)
remote = " ".join(argv[i + 1:] if host in argv else argv)
sess = None
m = re.search(r"tmux[^|;&]*?\s(?:-t|--target|-s|--session)\s*=\s*([A-Za-z0-9_.:-]+)", remote)
if not m:
    m = re.search(r"tmux[^|;&]*?\s(?:-t|--target|-s|--session)\s+([A-Za-z0-9_.:-]+)", remote)
if not m:
    m = re.search(r"tmux[^|;&]*?\bnew(?:-session)?\s+(?:-\S+\s+)*(?!-)([A-Za-z0-9_-]+)", remote)
if m:
    sess = m.group(1).split(":")[0]
if not sess:
    sys.exit(1)
user, _, hostonly = host.rpartition("@")  # ops@host → ("ops","host")；无 @ → ("","host")
host = hostonly
if not re.fullmatch(r"[A-Za-z0-9_.+-]{1,64}", host) or not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", sess):
    sys.exit(1)
if user and not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}", user):
    user = ""
print(json.dumps({"host": host, "session": sess, "user": user, "by": "ssh-shim"}))
PY
)
    [ -n "$payload" ] && curl -s -m 1 -X POST "${SSHX_CONTROL_URL:-http://127.0.0.1:8787}/api/observe" \
      -H 'content-type: application/json' -d "$payload" >/dev/null 2>&1
  fi
) &

exec "$REAL_SSH" "$@"
